# Copy this to .env and fill in your values.
# .env is gitignored — never commit real keys.

# OpenRouter API key — used for all LLM calls (openrouter/openai/gpt-4o-mini, etc.)
OPENROUTER_API_KEY=sk-or-...

# LiteLLM proxy master key (clients use this to authenticate)
LITELLM_MASTER_KEY=sk-1234

# HuggingFace token (needed to provision the gated SusFactor model)
HF_TOKEN=hf_...

# Model cache directory (default: ~/.cache/signature-sdk/models)
# SIGNATURE_SDK_MODEL_CACHE=/path/to/models

# Docker Compose overrides
# MODEL_CACHE_DIR=~/.cache/signature-sdk/models
# LITELLM_CONFIG_FILE=./examples/config-flag.yaml
